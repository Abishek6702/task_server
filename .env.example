PORT=5000
MONGO_URI=mongodb://localhost:27017/multi-tenant-task-manager
# Legacy fallback supported only when MONGO_URI is absent:
# MONGODB_URI=mongodb://localhost:27017/multi-tenant-task-manager
JWT_SECRET=development-only-change-this-secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Task Management <no-reply@example.com>
MAX_FILE_SIZE_MB=10
AUTH_RATE_LIMIT_MAX=10
